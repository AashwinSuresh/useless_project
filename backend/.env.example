# ==========================================
# The Internet's Most Unnecessary Search Engine
# ==========================================

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, xAI Grok API Key
XAI_API_KEY=your_grok_api_key_here

# Optional: Grok model (defaults to grok-2-latest)
GROK_MODEL=grok-2-latest

# Note: If no API key is provided, the engine will automatically run in
# high-octane "Offline Paranoia Oracle" fallback mode so demos never crash!
